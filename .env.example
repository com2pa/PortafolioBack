# Copia este archivo a .env y completa los valores

# Desarrollo (NODE_ENV !== production)
MONGO_URI_TEST=

# Producción (opcional). Si no está, se usa MONGO_URI_TEST
MONGO_URI_PROD=

ACCESS_TOKEN_SECRET=
EMAIL_USER=
EMAIL_PASS=
CONTACT_EMAILS=
PORT=5000
# Si sirves el front desde el mismo Express, usa la URL del API:
CLIENT_URL=http://localhost:5000
JWT_EXPIRES_IN=12h
# Admin inicial (se crea/sincroniza al arrancar)
# En Render: mismos valores, SIN comentarios en la misma línea
ADMIN_EMAIL=com2pa@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Merwil Vegas

# Mismo origen (API + dist): COOKIE_SAMESITE=lax
# COOKIE_SAMESITE=lax
# UPLOADS_DIR=/opt/render/project/src/uploads
